{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.12",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node ../../node_modules/vite/bin/vite.js --host 127.0.0.1 --port 3000 --strictPort",
    "build": "tsc -b && node ../../node_modules/vite/bin/vite.js build",
    "start": "bun run server.ts",
    "preview": "node ../../node_modules/vite/bin/vite.js preview --host 127.0.0.1 --port 3000 --strictPort",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mantine/core": "^7.17.8",
    "@mantine/hooks": "^7.17.8",
    "@tanstack/react-query": "^5.83.0",
    "motion": "^12.40.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-router-dom": "^7.6.3",
    "recharts": "^3.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.54.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5",
    "vite": "^7.3.5",
    "vitest": "^4.1.0"
  }
}
