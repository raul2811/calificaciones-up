{
  "name": "calificaciones-up",
  "private": true,
  "packageManager": "bun@1.3.12",
  "scripts": {
    "build:web": "cd apps/web && bun run build",
    "start:web": "cd apps/web && bun run start",
    "lint:web": "cd apps/web && bun run lint",
    "test:web": "cd apps/web && bun run test",
    "check:api": "cargo check --manifest-path apps/api/Cargo.toml",
    "docker:build:web": "docker build -f apps/web/Dockerfile -t calificaciones-up-web .",
    "docker:build:api": "docker build -t calificaciones-up-api apps/api",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "workspaces": [
    "apps/*"
  ],
  "overrides": {
    "postcss": "8.5.12"
  }
}
